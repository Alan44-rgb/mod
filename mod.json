{
  "geode": "6.0.0",
  "gd": { "win": "2.2091" },
  "id": "pulsecounter.input-display",
  "name": "Pulse Counter",
  "version": "v0.1.0",
  "developer": "Pulse Counter",
  "description": "Shows jump inputs and hold durations in Geometry Dash.",
  "resources": { "files": ["resources/ding.wav"] },
  "settings": {
    "release-markers": { "name": "Release markers", "type": "bool", "default": true },
    "sound": { "name": "Play ding on short holds", "type": "bool", "default": true },
    "ding-ms": { "name": "Short hold threshold (ms)", "type": "int", "default": 8, "min": 1, "max": 100 }
  }
}
